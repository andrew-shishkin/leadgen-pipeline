# ═══════════════════════════════════════════════════════════════════
#  Заполните нужные строки. Пустая строка = сервис просто не
#  используется, это нормально.
#
#  НЕ ставьте # перед строкой с ключом — закомментированную строку
#  скрипт не увидит, и сервис молча не подключится.
# ═══════════════════════════════════════════════════════════════════

# ─── Какая нейросеть считает (обязательно) ─────────────────────────
# anthropic — ключ с console.anthropic.com
# openai    — ключ с platform.openai.com (для тех, у кого подписка Codex)
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Модель. Пусто — возьмётся разумная по умолчанию.
QUALIFY_MODEL=
CHEAP_MODEL=

# Модель для поиска ЛПР в интернете. Пусто — Sonnet 5 на Anthropic
# и GPT-4o на OpenAI; выбрано так намеренно, экономить здесь нечего.
# Это единственный шаг, где модель читает сырую выдачу и решает, человек
# перед ней или просто совпадение названий.
SEARCH_MODEL=

# Только для openai: имя модели и цены за миллион токенов.
# Сверьтесь с developers.openai.com/api/docs/pricing перед большим прогоном.
#
# gpt-5   — $1.25 / $10 за миллион токенов, вдвое дешевле 4o на входе,
#           а вход у нас основной расход. Но требует разовой бесплатной
#           верификации организации: platform.openai.com/settings/organization/general.
#           Без неё API отвечает 404 «must be verified».
# gpt-4o  — $2.50 / $10, работает без верификации. Ставим по умолчанию,
#           чтобы прогон не падал на пустом месте.
OPENAI_MODEL=gpt-4o
OPENAI_PRICE_IN=2.5
OPENAI_PRICE_OUT=10

# ─── Потолок расхода за прогон, $ ──────────────────────────────────
MAX_SPEND_USD=25

# ─── Поиск ЛПР в интернете ─────────────────────────────────────────
# builtin — работает сразу, ключей не нужно. Но опирается на западные
#           индексы и по России находит заметно меньше.
# yandex  — выдача по РФ полнее и дешевле за запрос. Нужен аккаунт
#           в Яндекс Облаке: ключ и folder id.
# none    — этап выключен.
# auto = сам выберет: заполните два ключа ниже — пойдёт через Яндекс,
# оставите пустыми — встроенный поиск. Менять эту строку не нужно.
SEARCH_PROVIDER=auto

# Сколько должностей спрашивать отдельными запросами. Запрос выглядит как
# «директор по маркетингу РДТЕХ» — так же, как его набрали бы руками.
# Больше должностей — больше находок, но и больше запросов.
TITLE_QUERIES=8
# Сколько найденных страниц открывать и читать на компанию. Скачивание
# бесплатное, в модель уходит только вырезка со строками «должность + ФИО».
SEARCH_PAGES=10
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# ─── Платный поиск почт ────────────────────────────────────────────
# Шаг необязательный: почты собираются и со страниц сайтов бесплатно.
# Сервисы подключаются по желанию — оставьте пустым, шаг пропустится.
#
# Порядок опроса: слева направо, до первой найденной почты — нашёл первый,
# за остальных не платим. Запрос без результата кредит обычно не списывает.
# Первым ставьте тот, что на вашей базе находит чаще — остальные тогда
# просто не понадобятся.
EMAIL_WATERFALL=wiza,prospeo,fullenrich,findymail

# Сколько ждать ответа асинхронных сервисов, секунд. FullEnrich отвечает
# примерно за 70 секунд; при меньшем значении его ответ не успевает прийти,
# и в отчёте он выглядит как сервис, который ничего не находит.
ENRICH_POLL_SECONDS=180

# Сколько написаний имени пробовать в одном сервисе, прежде чем идти
# к следующему. Evgeniy / Evgenii, Mikhail / Mihail — сервисы ищут по точному
# совпадению, и на одном написании находят, а на другом нет.
ENRICH_NAME_VARIANTS=3

# Подбор почты по шаблону, когда ни один сервис не нашёл. Каждая проверка —
# кредит ZeroBounce; на домене catch-all подбор прекращается с первой проверки.
# Спрашивается при запуске, здесь только предел проверок на человека.
GUESS_MAX_CHECKS=6
PROSPEO_API_KEY=
FINDYMAIL_API_KEY=
WIZA_API_KEY=
FULLENRICH_API_KEY=

# Проверка почт. Пусто — шаг пропускается.
ZEROBOUNCE_API_KEY=

# ─── Прочее ────────────────────────────────────────────────────────
# Личные почты (@mail.ru, @ya.ru) — оставлять в базе?
KEEP_PERSONAL_EMAILS=true

# Информацию о должности старше этого года считаем неактуальной.
# Если в отчёте много «отсеяно по дате» — сдвиньте год назад.
FRESH_SINCE_YEAR=2022

DB_PATH=out/leadgen.db

# Печатать сырые ответы платных сервисов — для отладки адаптеров
ENRICH_DEBUG=
