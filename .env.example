# ─── Какая нейросеть считает ──────────────────────────────────────────
# anthropic — ключ с console.anthropic.com
# openai    — ключ с platform.openai.com (подходит тем, у кого подписка Codex)
LLM_PROVIDER=anthropic

# Заполните ключ ТОГО провайдера, который выбрали выше.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Модель. Оставьте пустым — возьмётся разумная по умолчанию
# (anthropic → claude-sonnet-5, openai → значение OPENAI_MODEL).
# Там, где нужно суждение, надёжность важнее экономии.
QUALIFY_MODEL=

# Только для openai: имя модели и её цены за миллион токенов.
# И то и другое у OpenAI меняется чаще, чем обновляется этот шаблон —
# сверьтесь с platform.openai.com/docs/pricing перед большим прогоном.
# OPENAI_MODEL=gpt-5
# OPENAI_PRICE_IN=1.25
# OPENAI_PRICE_OUT=10

# Потолок расхода за прогон, $. Превысили — скрипт останавливается и спрашивает.
MAX_SPEND_USD=25

DB_PATH=out/leadgen.db

# Личные почты (@mail.ru, @ya.ru и т.п.) — оставляем в базе
KEEP_PERSONAL_EMAILS=true

# Информацию о должности старше этого года считаем неактуальной
FRESH_SINCE_YEAR=2022

# Дешёвая модель для механических шагов (должности, склонения, проверка).
# Пусто — подберётся автоматически.
CHEAP_MODEL=

# ─── Поиск ЛПР в интернете ────────────────────────────────────────────
# builtin — работает сразу, ключей не нужно. Но опирается на западные
#           индексы и по РФ находит меньше. Самый дорогой этап конвейера.
# yandex  — выдача по России заметно полнее и дешевле за запрос.
#           Нужны аккаунт в Яндекс Облаке, ключ и folder id.
# none    — этап выключен.
SEARCH_PROVIDER=builtin
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=

# ─── Платный поиск почт (waterfall) ───────────────────────────────────
# Порядок опроса. Нашёл первый — за остальных не платим.
# Провайдер без ключа просто пропускается: конвейер работает и без них.
EMAIL_WATERFALL=prospeo,findymail,wiza,fullenrich
# ENRICH_DEBUG=true   # печатать сырые ответы сервисов — для отладки адаптеров
# WIZA_API_KEY=
# PROSPEO_API_KEY=
# FULLENRICH_API_KEY=
# FINDYMAIL_API_KEY=
# ZEROBOUNCE_API_KEY=
